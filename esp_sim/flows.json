        "id": "resp",
        "type": "coap response",
        "z": "tab_mangeoire",
        "name": "Reponse ACK",
        "statusCode": "",
        "contentFormat": "text/plain",
        "x": 600,
        "y": 380,
        "wires": []
    },
    {
        "id": "in_rfid",
        "type": "coap in",
        "z": "tab_mangeoire",
        "method": "POST",
        "name": "/rfid",
        "server": "srv_coap",
        "url": "/rfid",
        "x": 130,
        "y": 120,
        "wires": [
            [
                "fn_rfid"
            ]
        ]
    },
    {
        "id": "fn_rfid",
        "type": "function",
        "z": "tab_mangeoire",
        "name": "JSON RFID",
        "func": "// Reponse CoAP (ACK) + analyse du JSON recu sur /rfid\nconst rep = RED.util.cloneMessage(msg);\nrep.payload = \"OK\";\ntry {\n    msg.payload = JSON.parse(msg.payload.toString());\n} catch (e) {\n    node.warn(\"JSON invalide sur /rfid : \" + e.message);\n}\nmsg.topic = \"rfid\";\nreturn [msg, rep];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 120,
        "wires": [
            [
                "dbg_rfid"
            ],
            [
                "resp"
            ]
        ]
    },
