    {
        "id": "fn_alert",
        "type": "function",
        "z": "tab_mangeoire",
        "name": "JSON ALERTE",
        "func": "// Reponse CoAP (ACK) + analyse du JSON recu sur /alert\nconst rep = RED.util.cloneMessage(msg);\nrep.payload = \"OK\";\ntry {\n    msg.payload = JSON.parse(msg.payload.toString());\n    node.warn(\"ALERTE \" + msg.payload.type + \" | tag=\" + msg.payload.tag_id + \" | vache presente=\" + msg.payload.vache_presente);\n} catch (e) {\n    node.warn(\"JSON invalide sur /alert : \" + e.message);\n}\nmsg.topic = \"alert\";\nreturn [msg, rep];\n",
