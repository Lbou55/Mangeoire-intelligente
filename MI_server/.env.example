# Copy to .env for local use. On Render, set these in the dashboard (Environment).
# NEVER commit the real values.

MONGO_URI=mongodb+srv://oubaykh90_db_user:NEW_PASSWORD@mangeoire.dis68de.mongodb.net/
MONGO_DB=farm

# long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# public URL of this server (used in the acceptance link sent to admins)
PUBLIC_URL=https://mangeoire-server.onrender.com

# --- first superadmin (used only by scripts/seed_superadmin.py) ---
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-now
SUPERADMIN_NAME=Super Admin

# --- e-mail (Gmail example: use an "app password", not your real password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- measures coming from the Raspberry Pi (optional) ---
# Node-RED / Pi can POST to /ingest with header X-Ingest-Key
INGEST_KEY=
# or consume RabbitMQ (leave empty to disable)
AMQP_URL=
QUEUE_NAME=test_queue
